# Supabase (VisionaryHaus project) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Canonical site URL (metadata, sitemap, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email notification for new inquiries (Resend). Skipped when unset.
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=owner@example.com
INQUIRY_FROM_EMAIL="VisionaryHaus <inquiries@yourdomain.com>"

# Local-only, used by scripts/import-storage.mjs (an account listed in public.admins)
ADMIN_EMAIL=
ADMIN_PASSWORD=
